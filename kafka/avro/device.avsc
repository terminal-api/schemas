{
  "type": "record",
  "name": "Device",
  "namespace": "com.withterminal.api",
  "doc": "Type of device installed in a vehicle.",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "Unique identifier for the device in Terminal."
    },
    {
      "name": "connectionId",
      "type": "string",
      "doc": "Connection ID that produced this data."
    },
    {
      "name": "sourceId",
      "type": "string",
      "doc": "The ID of the record in the source system."
    },
    {
      "name": "provider",
      "type": "string",
      "doc": "Provider code identifying the telematics provider."
    },
    {
      "name": "type",
      "type": "string",
      "doc": "The type of device: tracker, camera."
    },
    {
      "name": "vehicle",
      "type": ["null", "string"],
      "default": null,
      "doc": "The ID of the vehicle that the device is associated with."
    },
    {
      "name": "description",
      "type": ["null", "string"],
      "default": null,
      "doc": "The description or model of the device."
    },
    {
      "name": "serialNumber",
      "type": ["null", "string"],
      "default": null,
      "doc": "The serial number of the device."
    },
    {
      "name": "lastConnectedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "Timestamp when the device was last connected."
    },
    {
      "name": "createdAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "Timestamp when the record was created in the source system."
    },
    {
      "name": "updatedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "Timestamp when the record was last updated in the source system."
    },
    {
      "name": "metadata",
      "type": "com.withterminal.api.CoreEntityMetadata",
      "doc": "Internal metadata about the record."
    },
    {
      "name": "raw",
      "type": [
        "null",
        {
          "type": "array",
          "items": "com.withterminal.api.RawData"
        }
      ],
      "default": null,
      "doc": "Raw data from the source provider."
    }
  ]
}
