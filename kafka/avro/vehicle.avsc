{
  "type": "record",
  "name": "Vehicle",
  "namespace": "com.withterminal.api",
  "doc": "The model representing a vehicle in Terminal.",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "Unique identifier for the vehicle in Terminal."
    },
    {
      "name": "connectionId",
      "type": "string",
      "doc": "Connection ID that produced this data."
    },
    {
      "name": "sourceId",
      "type": "string",
      "doc": "The ID of the record in the source system."
    },
    {
      "name": "provider",
      "type": "string",
      "doc": "Provider code identifying the telematics provider."
    },
    {
      "name": "status",
      "type": "string",
      "doc": "The status in the providers system: active, inactive."
    },
    {
      "name": "vin",
      "type": ["null", "string"],
      "default": null,
      "doc": "Vehicle Identification Number."
    },
    {
      "name": "name",
      "type": ["null", "string"],
      "default": null,
      "doc": "Name of the vehicle."
    },
    {
      "name": "make",
      "type": ["null", "string"],
      "default": null,
      "doc": "Vehicle manufacturer."
    },
    {
      "name": "model",
      "type": ["null", "string"],
      "default": null,
      "doc": "Vehicle model."
    },
    {
      "name": "year",
      "type": ["null", "int"],
      "default": null,
      "doc": "Vehicle year."
    },
    {
      "name": "groups",
      "type": [
        "null",
        {
          "type": "array",
          "items": "string"
        }
      ],
      "default": null,
      "doc": "List of group IDs the vehicle belongs to."
    },
    {
      "name": "devices",
      "type": [
        "null",
        {
          "type": "array",
          "items": "string"
        }
      ],
      "default": null,
      "doc": "List of device IDs associated with the vehicle."
    },
    {
      "name": "licensePlate",
      "type": ["null", "com.withterminal.api.LicensePlate"],
      "default": null,
      "doc": "License plate information."
    },
    {
      "name": "fuelType",
      "type": ["null", "string"],
      "default": null,
      "doc": "Fuel type: gasoline, diesel, propane, electric, hybrid_gasoline, hybrid_diesel."
    },
    {
      "name": "fuelTankCapacity",
      "type": ["null", "double"],
      "default": null,
      "doc": "Maximum amount of fuel vehicle can hold in liters."
    },
    {
      "name": "createdAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "Timestamp when the record was created in the source system."
    },
    {
      "name": "updatedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "Timestamp when the record was last updated in the source system."
    },
    {
      "name": "metadata",
      "type": "com.withterminal.api.CoreEntityMetadata",
      "doc": "Internal metadata about the record."
    },
    {
      "name": "raw",
      "type": [
        "null",
        {
          "type": "array",
          "items": "com.withterminal.api.RawData"
        }
      ],
      "default": null,
      "doc": "Raw data from the source provider."
    }
  ]
}
